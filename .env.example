# Copia questo file in .env e inserisci le tue chiavi.
# Il file .env è ignorato da git: non verrà mai committato.

# OpenWeatherMap — chiave gratuita da https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# --- Integrazione MCP (tutte opzionali, i default funzionano così come sono) ---

# Cartella del server MCP da avviare
# MCP_SERVER_DIR=mcp_integration/servers/devops_ansible

# Interprete con cui lanciare il server, se diverso da quello dell'app
# MCP_PYTHON=/percorso/assoluto/venv/bin/python

# Tool che richiedono approvazione umana prima di essere eseguiti (separati da virgola).
# Lista vuota = nessuna approvazione richiesta.
# MCP_APPROVAL_TOOLS=run_playbook_tool,bash_tool

# Registra bash_tool sul server MCP: esegue comandi shell arbitrari, abilitalo consapevolmente
# MCP_ENABLE_BASH=1

# --- Modalità vocale (voice/) ---

# Modello di trascrizione: tiny (~0.4s) | base (~0.6s, default) | small (~2.3s) | medium
# VOICE_STT_MODEL=base

# Voce della sintesi (elenco completo: edge-tts --list-voices)
# VOICE_TTS_VOICE=it-IT-DiegoNeural

# Silenzio che chiude il turno, in millisecondi: più basso = più reattivo, ma taglia le pause
# VOICE_SILENCE_MS=800

# Sensibilità del rilevamento voce: soglia = rumore di fondo x questo fattore
# VOICE_VAD_FACTOR=3.0

# Barge-in: interrompere l'assistente parlandogli sopra.
# Con gli altoparlanti la sua stessa voce rientra dal microfono: alzare il fattore o disattivarlo.
# VOICE_BARGE_IN=1
# VOICE_BARGE_IN_FACTOR=8.0

# Pausa fra la fine della risposta e il nuovo ascolto: evita che l'assistente senta la coda
# della propria voce dagli altoparlanti e si risponda da solo
# VOICE_COOLDOWN_MS=400

# Buffer dello stream di uscita: blocchi grandi evitano i singhiozzi quando CPU e GIL sono
# occupati da modello e sintesi. Abbassarlo riduce la latenza ma rischia l'audio a scatti.
# VOICE_OUT_BLOCKSIZE=2048
# VOICE_OUT_LATENCY=high

# Motore di sintesi vocale: "say" (voce di sistema macOS, predefinita: robusta, mai a scatti)
# oppure "edge" (voci neurali di edge-tts, più naturali ma passano dal player Python)
# VOICE_TTS_BACKEND=say
# VOICE_SAY_VOICE=Alice

# Modello usato da router e risposte. Il default llama3.2:3b è stato scelto misurando italiano,
# qualità delle risposte e accuratezza del routing contro qwen2.5-coder:3b e llama3.1:8b.
# LLM_MODEL=llama3.2:3b
